{
  "name": "reconcile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @reconcile/database generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "check": "pnpm harness:check && pnpm harness:test && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "agents:sync": "node scripts/sync-agents.mjs",
    "harness:check": "node scripts/check-harness.mjs",
    "harness:gate": "node scripts/check-harness.mjs --gate",
    "harness:test": "node --test scripts/check-harness.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "^5.9.3",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.7.0"
  }
}

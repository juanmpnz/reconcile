generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
 id String @id @default(uuid()) @db.Uuid
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 members Member[]
 invitations Invitation[]
 @@map("auth_users")
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 expiresAt DateTime
 token String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String @db.Uuid
 activeOrganizationId String? @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
 @@map("auth_sessions")
}
model Account {
 id String @id @default(uuid()) @db.Uuid
 accountId String
 providerId String
 userId String @db.Uuid
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([providerId,accountId])
 @@index([userId])
 @@map("auth_accounts")
}
model Verification {
 id String @id @default(uuid()) @db.Uuid
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
 @@map("auth_verifications")
}
model Organization {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 name String
 logo String?
 metadata String?
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
 members Member[]
 invitations Invitation[]
 documents Document[]
 operations Operation[]
 @@map("organizations")
}
model Member {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 userId String @db.Uuid
 role String @default("viewer")
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([organizationId,userId])
 @@index([userId])
 @@map("auth_members")
}
model Invitation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 email String
 role String
 status String @default("pending")
 expiresAt DateTime
 createdAt DateTime @default(now())
 inviterId String @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 inviter User @relation(fields:[inviterId],references:[id],onDelete:Cascade)
 @@index([organizationId,email])
 @@map("auth_invitations")
}
model RateLimit {
 id String @id @default(uuid()) @db.Uuid
 key String @unique
 count Int
 lastRequest BigInt
 @@map("auth_rate_limits")
}

// Immutable minimal identity evidence. No FK cascades: retain identifiers after deletion.
model IdentityAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  organizationId String? @db.Uuid
  action String @db.VarChar(64)
  outcome String @db.VarChar(16)
  requestId String? @db.VarChar(64)
  details Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([organizationId,createdAt])
  @@index([actorId,createdAt])
  @@map("identity_audit_events")
}

model Document {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 filename String @db.VarChar(200)
 kind String @db.VarChar(20)
 sizeBytes Int
 sha256 String @db.Char(64)
 storageKey String @unique
 status String @default("queued") @db.VarChar(20)
 errorCode String? @db.VarChar(64)
 currentRunId String? @db.Uuid
 runCount Int @default(0)
 correctionCount Int @default(0)
 uploadedBy String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 operationLinks OperationDocument[]
 factRevisions AnalysisFactRevision[]
 runs ExtractionRun[] @relation("DocumentRuns")
 currentRun ExtractionRun? @relation("CurrentRun",fields:[organizationId,id,currentRunId],references:[organizationId,documentId,id],onDelete:NoAction,onUpdate:NoAction)
 @@unique([organizationId,id])
 @@unique([organizationId,sha256])
 @@index([organizationId,createdAt])
 @@map("documents")
}
model ExtractionRun {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 documentId String @db.Uuid
 actorId String @db.Uuid
 version Int
 attempts Int @default(0)
 status String @default("queued") @db.VarChar(20)
 errorCode String? @db.VarChar(64)
 result Json?
 leaseUntil DateTime? @db.Timestamptz(3)
 leaseToken String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 completedAt DateTime? @db.Timestamptz(3)
 currentFor Document[] @relation("CurrentRun")
 document Document @relation("DocumentRuns",fields:[organizationId,documentId],references:[organizationId,id],onDelete:Cascade)
 corrections DocumentCorrection[]
 outbox DocumentOutbox?
 @@unique([organizationId,documentId,id])
 @@unique([documentId,version])
 @@map("extraction_runs")
}
model DocumentCorrection {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 documentId String @db.Uuid
 extractionRunId String @db.Uuid
 actorId String @db.Uuid
 revision Int
 field String @db.VarChar(32)
 value String? @db.VarChar(500)
 reason String @db.VarChar(500)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 run ExtractionRun @relation(fields:[organizationId,documentId,extractionRunId],references:[organizationId,documentId,id],onDelete:Cascade)
 @@unique([documentId,revision])
 @@index([organizationId,documentId,createdAt])
 @@map("document_corrections")
}
model DocumentOutbox {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 documentId String @db.Uuid
 runId String @unique @db.Uuid
 actorId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 lastEnqueuedAt DateTime? @db.Timestamptz(3)
 completedAt DateTime? @db.Timestamptz(3)
 run ExtractionRun @relation(fields:[organizationId,documentId,runId],references:[organizationId,documentId,id],onDelete:Cascade)
 @@unique([organizationId,documentId,runId])
 @@index([completedAt,lastEnqueuedAt])
 @@map("document_outbox")
}

model Operation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 reference String @db.VarChar(100)
 name String @db.VarChar(200)
 revision Int @default(0)
 runCount Int @default(0)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 documents OperationDocument[]
 facts AnalysisFactRevision[]
 analyses AnalysisRun[]
 @@unique([organizationId,id])
 @@unique([organizationId,reference])
 @@index([organizationId,createdAt])
 @@map("operations")
}
model OperationDocument {
 organizationId String @db.Uuid
 operationId String @db.Uuid
 documentId String @db.Uuid
 operation Operation @relation(fields:[organizationId,operationId],references:[organizationId,id],onDelete:Cascade)
 document Document @relation(fields:[organizationId,documentId],references:[organizationId,id],onDelete:Cascade)
 @@id([organizationId,operationId,documentId])
 @@map("operation_documents")
}
model AnalysisFactRevision {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 operationId String @db.Uuid
 documentId String @db.Uuid
 sourceFingerprint String @db.Char(64)
 ordinal Int
 facts Json
 actorId String @db.Uuid
 reason String @db.VarChar(500)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 operation Operation @relation(fields:[organizationId,operationId],references:[organizationId,id],onDelete:Cascade)
 document Document @relation(fields:[organizationId,documentId],references:[organizationId,id],onDelete:Cascade)
 @@unique([organizationId,operationId,ordinal])
 @@index([organizationId,operationId,documentId,ordinal])
 @@map("analysis_fact_revisions")
}
model AnalysisRun {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 operationId String @db.Uuid
 actorId String @db.Uuid
 version Int
 idempotencyKey String @db.Uuid
 fingerprint String @db.Char(64)
 parserVersion String @db.VarChar(64)
 ruleVersion String @db.VarChar(64)
 snapshot Json
 sources Json
 inputWarnings Json
 result Json?
 status String @default("queued") @db.VarChar(20)
 errorCode String? @db.VarChar(64)
 attempts Int @default(0)
 leaseUntil DateTime? @db.Timestamptz(3)
 leaseToken String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 completedAt DateTime? @db.Timestamptz(3)
 operation Operation @relation(fields:[organizationId,operationId],references:[organizationId,id],onDelete:Cascade)
 outbox AnalysisOutbox?
 @@unique([organizationId,operationId,id])
 @@unique([organizationId,operationId,idempotencyKey])
 @@unique([operationId,version])
 @@map("analysis_runs")
}
model AnalysisOutbox {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 operationId String @db.Uuid
 runId String @unique @db.Uuid
 actorId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 lastEnqueuedAt DateTime? @db.Timestamptz(3)
 completedAt DateTime? @db.Timestamptz(3)
 run AnalysisRun @relation(fields:[organizationId,operationId,runId],references:[organizationId,operationId,id],onDelete:Cascade)
 @@unique([organizationId,operationId,runId])
 @@index([completedAt,lastEnqueuedAt])
 @@map("analysis_outbox")
}

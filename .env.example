# Local development only. Replace every credential before exposing a deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://reconcile:local-demo-password@localhost:5432/reconcile?connect_timeout=3&pool_timeout=3
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reconcile-demo
S3_ACCESS_KEY_ID=reconcile-local
S3_SECRET_ACCESS_KEY=local-demo-storage-password
WORKER_CONCURRENCY=2

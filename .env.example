# Local development only. Replace every credential before exposing a deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# pnpm dev uses this port for both the API and Vite proxy.
DEV_API_PORT=3001
DATABASE_URL=postgresql://reconcile:local-demo-password@localhost:5433/reconcile?connect_timeout=3&pool_timeout=3
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reconcile-demo
S3_ACCESS_KEY_ID=reconcile-local
S3_SECRET_ACCESS_KEY=local-demo-storage-password
WORKER_CONCURRENCY=2

# Same public origin: Vite proxies /api during local development.
AUTH_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
AUTH_SECRET=local-development-secret-replace-before-deployment-2026
# Enable locally to exercise mandatory authenticator enrollment before workspace access.
AUTH_REQUIRE_MFA=false
MAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@reconcile.invalid
